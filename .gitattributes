# Keep LF endings on everything the pipeline executes.
#
# On a Windows checkout git converts text files to CRLF. The containers run
# Linux, where a script whose shebang ends in CR fails with
#     /usr/bin/env: 'python3\r': No such file or directory
# and nextflow reports it as a missing output file, which points nowhere near
# the real cause. Nextflow puts bin/ on PATH and the processes call these
# scripts by name, so the shebang has to survive the checkout.

*.py    text eol=lf
*.sh    text eol=lf
*.nf    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.rmd   text eol=lf
*.config text eol=lf

# Reference data: byte-for-byte, never transformed.
*.fasta  -text
*.fa     -text
*.fsa    -text
*.fastq  -text
*.tsv    text eol=lf
*.bed    text eol=lf
*.vcf    text eol=lf
