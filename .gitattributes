# Keep LF endings on everything the pipeline executes.
#
# On a Windows checkout git converts text files to CRLF. The containers run
# Linux, where a script whose shebang ends in CR fails with
#     /usr/bin/env: 'python3\r': No such file or directory
# and nextflow reports it as a missing output file, which points nowhere near
# the real cause. Nextflow puts bin/ on PATH and the processes call these
# scripts by name, so the shebang has to survive the checkout.

*.py    text eol=lf
*.sh    text eol=lf
*.nf    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.rmd   text eol=lf
*.config text eol=lf

# Reference data: byte-for-byte, never transformed.
*.fasta  -text
*.fa     -text
*.fsa    -text
*.fastq  -text
*.tsv    text eol=lf
*.bed    text eol=lf
*.vcf    text eol=lf

# Galaxy tool, planemo scripts and web page: LF whatever the core.autocrlf setting
# (a CRLF line ending breaks the bash and python scripts: $'\r': command not found).
# Binary files are detected and kept as they are.
galaxy/** text=auto eol=lf
web/**    text=auto eol=lf
*.yml     text eol=lf
# Test data of the Galaxy tool: byte-for-byte, as the reference data.
galaxy/test-data/** -text
