/*
#########################################################################
##                                                                     ##
##     nextflow.config of repertoire profiler                          ##
##                                                                     ##
##     Institut Pasteur Paris                                          ##
##                                                                     ##
#########################################################################
*/

/*
#########################################################################
##                                                                     ##
##     Parameters that must be set by the user                         ##
##                                                                     ##
#########################################################################
*/


/*
########################
##                    ##
##     Data           ##
##                    ##
########################
*/

params {
    fastq_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/SRR26617475/" // SRA accession ID (e.g., "SRR26617638"). The workflow will automatically download and extract from SRA. Can also be a local path (directory with fastq files) or a .zip file. Example: fastq_path = "/path/to/fastq/files" or fastq_path = "https://zenodo.org/records/18631337/files/human_IGH.zip".
    ref_path = "./mating_type_refs" // single character string indicating the path of the genome reference directory for bowtie2 read alignments. The directory must contain fasta files only. If several references indicated, the fastq files are aligned on each reference (parallelization). The directory can be a .zip file. For MATA/MATALPHA genotype detection, use "./mating_type_refs".
    features_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/features_test/individual_feature_fastas" // single character string indicating the path of the genome reference directory for bowtie2 read alignments. The directory must contain fasta files only. If several features indicated, the fastq files are aligned on each feature (parallelization). The directory can be a .zip file.
    ylab = "200"  // single integer between quotes, indicating the coverage depth y-axis range.
}



/*
######################################
##                                  ##
##     Local / Cluster execution    ##
##                                  ##
######################################
*/

params.apptainer_local_images = "/mnt/c/Users/gmillot/apptainer" // single character string of the path of the apptainer folder (where all the apptainer images are are pulled and stored for proper nextflow execution). You can indicate an empty folder. In that case, docker images will be pulled from dockerhub, converted into apptainer images and stored into this indicted folder for next executions. Example: apptainer_local_images='/mnt/c/Users/gmillot/apptainer'. Example: apptainer_local_images="$projectDir/apptainer" # do not forget double quotes in that case. See https://confluence.pasteur.fr/pages/viewpage.action?pageId=69304504.
params.apptainer_cluster_images = "/pasteur/helix/projects/BioIT/gmillot/apptainer" // as for apptainer_local_images but for a cluster usage. It must be a shared folder accessible to all computing nodes. Example: apptainer_local_images='/pasteur/helix/projects/BioIT/gmillot/apptainer'.
params.system_exec = 'local' // single character string of the system that runs the workflow. Write 'local' to run on our own computer or any job scheduler managed by nextflow. See the list here: https://www.nextflow.io/docs/latest/executor.html. Example system_exec = 'slurm' (pasteur cluster). Example: system_exec = 'local'. Warning: when using "slurm" other than for the Pasteur cluster, it must be necessary to modify runOptions = '--no-home --bind /pasteur' below. Please, use add_options = '-cwd -l s_vmem=60G' when using sge
params.cluster_runOptions = "NULL" // single character string of the runOptions parameter of the scheduler. If "NULL", then default values are used, depending on the system_exec setting: (1) if system_exec == 'slurm', then runOptions = '--no-home --bind /pasteur --bind /local --bind /run', (2) if system_exec == 'sge', then runOptions = '--bind /rshare1:/rshare1', (3) if system_exec == 'local', then runOptions = '--no-home -B /run/shm:/run/shm'. Please, write the correct runOptions setting if unsure of your environment, or to overwrite this default setting.
params.simult_jobs = 50000 // number of max simultaneous jobs. This is to avoid to saturated a cluster if millions of jobs in parallel. Write 0 for all the threads.
params.slurm_queue = 'common,dedicated' // single character string of the -p option of slurm. Example: slurm_queue = 'common,dedicated'. Example: slurm_queue = 'hubbioit'. Example slurm_queue = 'long,hubbioit' for long processes.
params.slurm_qos = '--qos=fast' // single character string of the --qos option of slurm. Example: slurm_qos= '--qos=fast'. Example: slurm_qos = '--qos=ultrafast'. Example: slurm_qos = '--qos=hubbioit'
params.add_options = ' ' // single character string of the additional option of slurm. Example: add_options = '--exclude=maestro-1101,maestro-1034' or add_options = ' ', add_options = '--time=70:00:00' (acceptable time formats include "minutes", "minutes:seconds", "hours:minutes:seconds", "days-hours", "days-hours:minutes" and "days-hours:minutes:seconds"). See https://slurm.schedmd.com/sbatch.html#OPT_time for other options.  Please, use add_options = '-cwd -l s_vmem=60G' when using system_exec = 'sge'.



/*
#########################################
##                                     ##
##     Optional: Alignments            ##
##                                     ##
#########################################
*/




/*
#############################
##                         ##
##     Optional: Other     ##
##                         ##
#############################
*/


params.out_path_ini = "$projectDir/results" // single character string of where the output files will be saved. Example out_path_ini = '.' for where the main.nf run is executed or out_path_ini = "$projectDir/results" to put the results in a result folder (created if required), $projectDir indicating where the main.nf script is located. Example: out_path_ini = '/mnt/c/Users/gmillot/Desktop'. Example : out_path_ini="/pasteur/helix/projects/BioIT/gmillot/08002_bourgeron/results". Warning: this does not work: out_path_ini = "/mnt/share/Users/gmillot/Desktop"
params.result_folder_name = "biosentinelle" // single character string.of the name of the folder where the results files are dorpped


/*
#########################################################################
##                                                                     ##
##     End Parameters that must be set by the user                     ##
##                                                                     ##
#########################################################################
*/




//////// Pre processing

params.secs = ((new Date().getTime())/1000) as long
params.out_path ="${params.out_path_ini}/${params.result_folder_name}_${params.secs}"

//////// end Pre processing


/////// variables in the main.nf file only

params {
    template_rmd_path = "./bin/biosentinelle_template.rmd"
    cute_path = "./bin/cute_little_R_functions_v12.8.R" // single character string indicating the file (and absolute pathway) of the required cute_little_R_functions toolbox. With ethernet connection
}

/////// variables in the main.nf file only


//////// variables used here and also in the main.nf file

env {
    system_exec = "${params.system_exec}"
    out_path_ini = "${params.out_path_ini}"
    out_path = "${params.out_path}"
    slurm_queue = "${params.slurm_queue}"
    slurm_qos = "${params.slurm_qos}"
    add_options = "${params.add_options}"
}

//////// end variables used here and also in the main.nf file


//////// variables used in the main.nf and in the ./conf/checks.nf files


//////// end variables used in the main.nf and in the ./conf/checks.nf files


//////// Scopes

// those are closures. See https://www.nextflow.io/docs/latest/script.html#closures
executor {
    // name = "slurm" // means "if name of the executor is slurm, then ${simult_jobs}, i.e., max ${simult_jobs} simultaneous jobs". Inactivated because applied to all kinds of executors
    queueSize = "${params.simult_jobs}" // can only be written here and not below because queueSize is a method of executor{}
}

// create a report folder and print a html report file . If no absolute path, will be where the run is executed
// see https://www.nextflow.io/docs/latest/config.html#config-report
report {
       enabled = true
       file = "${params.out_path}/reports/report.html" // warning: here double quotes to get the nextflow variable interpretation
}

// txt file with all the processes and info
trace {
    enabled = true
    file = "${params.out_path}/reports/trace.txt"
}

// html file with all the processes
timeline {
    enabled = true
    file = "${params.out_path}/reports/timeline.html"
}

// .dot picture of the workflow
dag {
    enabled = true
    file = "${params.out_path}/reports/nf_dag.png"
}


// define apptainer parameters
apptainer {
    enabled = true
    autoMounts = true // automatically mounts host paths in the executed container
    pullTimeout = '7d'
    runOptions = params.cluster_runOptions == "NULL" ? (
        params.system_exec == 'slurm' ? '--no-home --bind /pasteur --bind /local --bind /run' :
        params.system_exec == 'sge' ? '--no-home --bind /rshare1:/rshare1' :
        params.system_exec == 'local' ? '--no-home -B /run/shm:/run/shm' : ''
    ) : "${params.cluster_runOptions}"
    //runOptions = '--home $HOME:/home/$USER --bind /pasteur' // provide any extra command line options supported by the apptainer exec. Here, fait un bind de tout /pasteur dans /pasteur du container. Sinon pas d accès
    cacheDir = params.system_exec == 'local' ? "${params.apptainer_local_images}" : "${params.apptainer_cluster_images}"
}

//////// end Scopes



//////// directives

// provide the default directives for all the processes in the main.nf pipeline calling this config file
process {
// directives for all the processes
    executor = "${params.system_exec}"
    // process.shell = ['/bin/bash', '-euo', 'pipefail']
    // beforeScript = 'module load apptainer'
// end directives for all the processes
    queue = params.system_exec == 'slurm' ? "${params.slurm_queue}" : null
    clusterOptions = params.system_exec == 'slurm' ? "${params.slurm_qos} ${params.add_options}" : (params.system_exec != 'local' ? "${params.add_options} -S /bin/bash" : null)
    scratch = params.system_exec == 'slurm' ? false : null
    beforeScript = params.system_exec != 'local' && params.system_exec != 'slurm' ? '''
            module use /usr/local/package/modulefiles
            module load apptainer/1.2.4
        ''' : null
    penv = params.system_exec != 'local' && params.system_exec != 'slurm' ? 'mpi' : null // penv stands for Parallel Environment (PE)
    maxRetries = params.system_exec == 'local' ? 0 : 3
    errorStrategy = { params.system_exec == 'local' ? 'terminate' : (task.exitStatus in 137..143 ? 'retry' : 'terminate') } // 137 is memory, 143 is time limit

    withLabel: bash {
        container = 'gmillot/bash-extended_v4.0:gitlab_v8.0'
        cpus = 1
        memory = '500M'
    }

    withLabel: unzip {
        container='gmillot/ubuntu_v22.04_extended_v1.0:gitlab_v10.2'
        cpus=1
        memory='1G'
    }

    withLabel: bowtie2 {
        container='gmillot/bowtie2_v2.3.4.3_extended_v2.0:gitlab_v8.0'
        cpus=12 // only used when name = "local" in the executor part above
        memory = params.system_exec == 'slurm' ? '16G' : '32G'
    }

    withLabel: fastq_dump {
        container='dceoy/fastq-dump'
        errorStrategy='terminate'  // Changed from 'ignore' to catch fastq-dump failures
        cpus=1
    }

    withLabel: multiqc {
        container='ewels/multiqc:1.10.1'
        errorStrategy='ignore'
        cpus=1
    }

    withLabel: samtools {
        container='gmillot/samtools_v1.14:gitlab_v8.0'
        cpus=1
        memory='1G'
    }

    withLabel: bcftools {
        container='gmillot/bcftools_v1.14:gitlab_v8.0'
        cpus=4
        memory='2G'
    }

    withLabel: bedtools {
        container='gmillot/bedtools_v2.30.0:gitlab_v8.0'
        cpus=12
        memory='64G'
    }

    withLabel: python {
        container = 'evolbioinfo/python-evol:v3.7.3condor'
        cpus = 1
        memory='3G'
    }

    withLabel: r_ig_clustering {
        container='gmillot/r_v4.1.2_ig_clustering_v1.3:gitlab_v9.9'
        cpus=1
        memory='3G'
    }
}

//////// end directives
