/*
#########################################################################
##                                                                     ##
##     nextflow.config of repertoire profiler                          ##
##                                                                     ##
##     Institut Pasteur Paris                                          ##
##                                                                     ##
#########################################################################
*/

/*
#########################################################################
##                                                                     ##
##     Parameters that must be set by the user                         ##
##                                                                     ##
#########################################################################
*/


/*
########################
##                    ##
##     Data           ##
##                    ##
########################
*/

env {
    fastq_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/SRR26617475/" // SRA accession ID (e.g., "SRR26617638"). The workflow will automatically download and extract from SRA. Can also be a local path (directory with fastq files) or a .zip file. Example: fastq_path = "/path/to/fastq/files" or fastq_path = "https://zenodo.org/records/18631337/files/human_IGH.zip".
    ref_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/genome_references/test" // single character string indicating the path of the genome reference directory for bowtie2 read alignments. The directory must contain fasta files only. If several references indicated, the fastq files are aligned on each reference (parallelization). The directory can be a .zip file. For MATA/MATALPHA genotype detection, use "./mating_type_refs".
    features_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/features_test/individual_feature_fastas" // single character string indicating the path of the genome reference directory for bowtie2 read alignments. The directory must contain fasta files only. If several features indicated, the fastq files are aligned on each feature (parallelization). The directory can be a .zip file.
    sex_path = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/mating_type" // single character string indicating the path of the mating type reference directory for bowtie2 read alignments. The directory must contain fasta files only. The directory can be a .zip file.
    ylab = "200"  // single integer between quotes, indicating the coverage depth y-axis range.
}


/*
####################################
##                                ##
##     Strain identity database   ##
##                                ##
####################################
*/

env {
    db_path = "$projectDir/db" // single character string indicating the root of the strain identity database. One sub directory per organism. Example: db_path = "$projectDir/db".
    organism_dir = "yeast" // single character string indicating the organism sub directory of db_path used for this run. This is the only setting to change when switching model organism, provided the corresponding database has been built. Example: organism_dir = "yeast".
    organism_name = "Saccharomyces cerevisiae" // single character string of the organism full name, written into the report.
    strain_id_on = "TRUE" // single character string, "TRUE" or "FALSE", indicating whether the strain identity branch of the pipeline is run. Set to "FALSE" to run the historical coverage and variant counting only.

    // read scanning
    kmer_max_bases = "0" // single integer between quotes, indicating the number of read bases scanned for the strain panel, 0 for all of them.
// The cap is in bases, not reads, because coverage is what decides whether a
// site gets called and read length varies by an order of magnitude. A cap of
// 400000 reads is 60 Mb at 150 bp but only 14 Mb at 35 bp, which on a 12 Mb
// genome is 5x against 1.2x: the same setting is comfortable on one platform
// and useless on the other. On the SRR26617475 run it called 335 sites out of
// 36694.
// Scanning everything costs about 90 s for 275 Mb, so 0 is a sensible default.
// For a much larger genome or a very deep run, 300000000 gives roughly 25x on
// a 12 Mb genome; scale it with the genome.
    kmer_min_depth = "3" // single integer between quotes, indicating the number of panel k-mer observations required before a site is called. Below it the site is reported as not covered, never as carrying the reference allele.

    // scoring
    strain_error_rate = "0.01" // single number between quotes, between 0 and 0.5, indicating the assumed probability that a called allele disagrees with the true strain. It covers sequencing error, culture drift and panel error together. Raising it makes the ranking less confident, it does not change the order.
    marker_min_depth = "4" // single integer between quotes, indicating the number of well mapped reads (mapping quality 20 or more) needed at a position of a native marker gene before it is read. Below it the position is unknown, never the reference: a gene is called through such positions only when no catalogued allele differs from the reference there.
    min_concordance = "0.90" // single number between quotes, between 0 and 1. If the best strain matches less than this fraction of its expected alleles, the sample is reported as unassigned rather than forced onto the closest panel member. This is what catches a strain that is not in the database.
}


/*
####################################
##                                ##
##     Database construction      ##
##                                ##
####################################
*/

// Only used by build_db.nf, except panel_reference, which main.nf also uses: the
// native marker genes are genotyped from reads aligned to this genome, in whose
// coordinates the marker loci are written. The analysis pipeline reads the
// database, it never writes it.
env {
    strain_table = "$projectDir/db/yeast/strains/strains.tsv" // single character string indicating the strain catalogue written by bin/build_strain_catalog.py: one row per strain, with source_type (matrix, assembly or reads) and source (sample name in population_matrix, assembly path, or comma separated run accessions).
    population_matrix = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/1011genomes/sparse_gt.tsv.gz" // single character string indicating the sparse genotype table of the population matrix: CHROM, POS, REF, ALT, then SAMPLE:GT:AD for every sample not homozygous reference. Made from 1011Matrix.gvcf.gz (1011 Yeast Genomes, Peter et al. 2018) with bcftools query, see db/README.md.
    reads_dir = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/sra_lab" // single character string indicating the directory of the read runs of the strains whose source_type is reads, named <run>_1.fastq.gz and <run>_2.fastq.gz, or <run>.fastq.gz.
    reads_min_depth = "10" // single integer between quotes, indicating the read depth, at mapping and base quality 20, below which a position of a read run is not callable. Not callable means unknown, never reference.
    panel_reference = "/mnt/c/Users/gmillot/Documents/Git_projects/biosentinelle/dataset/genome_references/test/S288C_reference_sequence_R64-1-1_20110203.fsa" // single character string indicating the reference genome FASTA. It is the coordinate system of the whole database: changing it invalidates every panel built before.
    panel_kmer_size = "21" // single odd integer between quotes, indicating the k-mer length. The variant sits in the middle, so k = 21 means 10 bases of context on each side.
// Choosing k. The binding constraint is read length, not specificity. A read of
// length L yields L - k + 1 k-mers, so k = 31 on 35 bp reads leaves 5 per read,
// and a single sequencing error destroys most of them: on the SRR26617475 run
// that produced 14 called sites out of 35263. k = 21 leaves 15 per read and
// calls the panel comfortably.
// Specificity is not the limit here: a 12 Mb genome contains 12e6 of the 4^21
// possible 21-mers, so a chance match is vanishingly unlikely, and in any case
// build_snp_panel.py verifies empirically that every probe occurs exactly once
// in the reference and drops the ones that do not.
// Raise k for a larger genome or for longer reads, keeping k well below the
// read length. Changing it invalidates every panel, so rebuild all of them.
    panel_options = "--per-strain-sites 300 --rare-max-carriers 20 --common-sites 30000 --max-unknown-fraction 0.10" // single character string of options passed to bin/build_population_panel.py. --per-strain-sites: rare sites kept per strain, rarest first; they are what separates close relatives. --rare-max-carriers: a site carried by at most this many strains is rare. --common-sites: common sites kept on top, evenly spread, which place a sample in its clade. --max-unknown-fraction: sites unknown in more strains than this are dropped.
}



/*
######################################
##                                  ##
##     Local / Cluster execution    ##
##                                  ##
######################################
*/

apptainer_local_images = "/mnt/c/Users/gmillot/apptainer" // single character string of the path of the apptainer folder (where all the apptainer images are are pulled and stored for proper nextflow execution). You can indicate an empty folder. In that case, docker images will be pulled from dockerhub, converted into apptainer images and stored into this indicted folder for next executions. Example: apptainer_local_images='/mnt/c/Users/gmillot/apptainer'. Example: apptainer_local_images="$projectDir/apptainer" # do not forget double quotes in that case. See https://confluence.pasteur.fr/pages/viewpage.action?pageId=69304504.
apptainer_cluster_images = "/pasteur/helix/projects/BioIT/gmillot/apptainer" // as for apptainer_local_images but for a cluster usage. It must be a shared folder accessible to all computing nodes. Example: apptainer_local_images='/pasteur/helix/projects/BioIT/gmillot/apptainer'. 
system_exec = 'local' // single character string of the system that runs the workflow. Write 'local' to run on our own computer or any job scheduler managed by nextflow. See the list here: https://www.nextflow.io/docs/latest/executor.html. Example system_exec = 'slurm' (pasteur cluster). Example: system_exec = 'local'. Warning: when using "slurm" other than for the Pasteur cluster, it must be necessary to modify runOptions = '--no-home --bind /pasteur' below. Please, use add_options = '-cwd -l s_vmem=60G' when using sge
cluster_runOptions = "NULL" // single character string of the runOptions parameter of the scheduler. If "NULL", then default values are used, depending on the system_exec setting: (1) if system_exec == 'slurm', then runOptions = '--no-home --bind /pasteur --bind /local --bind /run', (2) if system_exec == 'sge', then runOptions = '--bind /rshare1:/rshare1', (3) if system_exec == 'local', then runOptions = '--no-home -B /run/shm:/run/shm'. Please, write the correct runOptions setting if unsure of your environment, or to overwrite this default setting.
simult_jobs = 50000 // number of max simultaneous jobs. This is to avoid to saturated a cluster if millions of jobs in parallel. Write 0 for all the threads.
slurm_queue = 'common,dedicated' // single character string of the -p option of slurm. Example: slurm_queue = 'common,dedicated'. Example: slurm_queue = 'hubbioit'. Example slurm_queue = 'long,hubbioit' for long processes.
slurm_qos = '--qos=fast' // single character string of the --qos option of slurm. Example: slurm_qos= '--qos=fast'. Example: slurm_qos = '--qos=ultrafast'. Example: slurm_qos = '--qos=hubbioit'
add_options = ' ' // single character string of the additional option of slurm. Example: add_options = '--exclude=maestro-1101,maestro-1034' or add_options = ' ', add_options = '--time=70:00:00' (acceptable time formats include "minutes", "minutes:seconds", "hours:minutes:seconds", "days-hours", "days-hours:minutes" and "days-hours:minutes:seconds"). See https://slurm.schedmd.com/sbatch.html#OPT_time for other options.  Please, use add_options = '-cwd -l s_vmem=60G' when using system_exec = 'sge'.



/*
#########################################
##                                     ##
##     Optional: Alignments            ##
##                                     ##
#########################################
*/




/*
#############################
##                         ##
##     Optional: Other     ##
##                         ##
#############################
*/


out_path_ini = "$projectDir/results" // single character string of where the output files will be saved. Example out_path_ini = '.' for where the main.nf run is executed or out_path_ini = "$projectDir/results" to put the results in a result folder (created if required), $projectDir indicating where the main.nf run is executed. Example: out_path_ini = '/mnt/c/Users/gmillot/Desktop'. Example : out_path_ini="/pasteur/helix/projects/BioIT/gmillot/08002_bourgeron/results". Warning: this does not work: out_path_ini = "/mnt/share/Users/gmillot/Desktop"
result_folder_name = "biosentinelle" // single character string.of the name of the folder where the results files are dorpped


/*
#########################################################################
##                                                                     ##
##     End Parameters that must be set by the user                     ##
##                                                                     ##
#########################################################################
*/




//////// Pre processing

int secs = (new Date().getTime())/1000
out_path ="${out_path_ini}/${result_folder_name}_${secs}"

//////// end Pre processing


/////// variables in the main.nf file only

env{
    template_rmd_path = "./bin/biosentinelle_template.rmd"
    cute_path = "./bin/cute_little_R_functions_v12.8.R" // single character string indicating the file (and absolute pathway) of the required cute_little_R_functions toolbox. With ethernet connection 
}

/////// variables in the main.nf file only


//////// variables used here and also in the main.nf file

env {
    system_exec = "${system_exec}"
    out_path_ini = "${out_path_ini}"
    out_path = "${out_path}"
    slurm_queue = "${slurm_queue}"
    slurm_qos = "${slurm_qos}"
    add_options = "${add_options}"
}

//////// end variables used here and also in the main.nf file


//////// variables used in the main.nf and in the ./conf/checks.nf files


//////// end variables used in the main.nf and in the ./conf/checks.nf files


//////// Scopes

// those are closures. See https://www.nextflow.io/docs/latest/script.html#closures
executor { 
    // name = "slurm" // means "if name of the executor is slurm, then ${simult_jobs}, i.e., max ${simult_jobs} simultaneous jobs". Inactivated because applied to all kinds of executors
    queueSize = "${simult_jobs}" // can only be written here and not below because queueSize is a method of executor{}
}

// create a report folder and print a html report file . If no absolute path, will be where the run is executed
// see https://www.nextflow.io/docs/latest/config.html#config-report
report {
       enabled = true
       file = "${out_path}/reports/report.html" // warning: here double quotes to get the nextflow variable interpretation
}

// txt file with all the processes and info
trace {
    enabled = true
    file = "${out_path}/reports/trace.txt"
}

// html file with all the processes
timeline {
    enabled = true
    file = "${out_path}/reports/timeline.html"
}

// .dot picture of the workflow
dag {
    enabled = true
    file = "${out_path}/reports/nf_dag.png"
}


// define apptainer parameters
apptainer {
    enabled = true
    autoMounts = true // automatically mounts host paths in the executed container
    pullTimeout = '7d'
    if(cluster_runOptions == "NULL"){
        if(system_exec == 'slurm'){
            runOptions = '--no-home --bind /pasteur --bind /local --bind /run' //-B /run/shm:/run/shm has been removed because block the pipeline. Warning: clone_assignment process use python. Thus, -B /run/shm:/run/shm should be required normally
        }
        if(system_exec == 'sge'){
            runOptions = '--no-home --bind /rshare1:/rshare1'
        }
        if(system_exec == 'local'){
            runOptions = '--no-home -B /run/shm:/run/shm' // --no-home prevent apptainer to mount the $HOME path and thus forces apptainer to work with only what is inside the container
        }
    }else{
        runOptions = "${cluster_runOptions}"
    }
    //runOptions = '--home $HOME:/home/$USER --bind /pasteur' // provide any extra command line options supported by the apptainer exec. Here, fait un bind de tout /pasteur dans /pasteur du container. Sinon pas d accès
    if(system_exec == 'local'){
        cacheDir = "${apptainer_local_images}" // "$projectDir/apptainer" can be used but do not forget double quotes.
    }else{
        cacheDir = "${apptainer_cluster_images}" // name of the directory where remote Apptainer images are stored. When rerun, the exec directly uses these without redownloading them. When using a computing cluster it must be a shared folder accessible to all computing nodes
    }
}

//////// end Scopes



//////// directives

// provide the default directives for all the processes in the main.nf pipeline calling this config file
process {
// directives for all the processes
    executor = "${system_exec}"
    // process.shell = ['/bin/bash', '-euo', 'pipefail']
    // beforeScript = 'module load apptainer'
// end directives for all the processes
    if(system_exec == 'slurm'){
        queue = "$slurm_queue"
        clusterOptions = "$slurm_qos $add_options"
        scratch=false
        maxRetries=3
        errorStrategy = {task.exitStatus in 137..143 ? 'retry' : 'terminate' }
    }else if(system_exec != 'local'){
        beforeScript= '''
            module use /usr/local/package/modulefiles
            module load apptainer/1.2.4
        '''
        penv = 'mpi' // penv stands for Parallel Environment (PE). 'mpi' is a common parallel environment name, often used for Message Passing Interface (MPI) jobs. Please, run qconf -spl on the cluster login node to list available parallel environments. Common PEs are smp, mpi, or similar.
        clusterOptions = "$add_options -S /bin/bash"
        maxRetries=3
        errorStrategy = {task.exitStatus in 137..143 ? 'retry' : 'terminate' } // 137 is memory, 143 is time limit
    }else if(system_exec == 'local'){
        maxRetries=0
        errorStrategy='terminate'
    }

    withLabel: bash {
        container = 'gmillot/bash-extended_v4.0:gitlab_v8.0'
        cpus = 1
        memory = '500M'
    }

    withLabel: unzip {
        container='gmillot/ubuntu_v22.04_extended_v1.0:gitlab_v10.2'
        cpus=1
        memory='1G'
    }

    withLabel: bowtie2 {
        container='gmillot/bowtie2_v2.3.4.3_extended_v2.0:gitlab_v8.0'
        cpus=12 // only used when name = "local" in the executor part above
        if(system_exec == 'slurm'){
            memory='16G'
        }else{
            memory='32G'
        }
    }

    withLabel: fastq_dump {
        container='dceoy/fastq-dump'
        errorStrategy='terminate'  // Changed from 'ignore' to catch fastq-dump failures
        cpus=1
    }

    withLabel: multiqc {
        container='ewels/multiqc:1.10.1'
        errorStrategy='ignore'
        cpus=1
    }

    withLabel: samtools {
        container='gmillot/samtools_v1.14:gitlab_v8.0'
        cpus=1
        memory='1G'
    }

    withLabel: bcftools {
        container='gmillot/bcftools_v1.14:gitlab_v8.0'
        cpus=4
        memory='2G'
    }

    withLabel: bedtools {
        container='gmillot/bedtools_v2.30.0:gitlab_v8.0'
        cpus=12
        memory='64G'
    }

    withLabel: python {
        container = 'evolbioinfo/python-evol:v3.7.3condor'
        cpus = 1
        memory='3G'
    }

    // Used by build_db.nf only. Warning: the image must provide paftools.js and
    // the k8 shell it runs on, which ship with the minimap2 source but are not
    // in every minimap2 image. Check with
    //     apptainer exec <image> paftools.js version
    // before the first database build, and change the image here if it fails.
    withLabel: minimap2 {
        container='staphb/minimap2:2.28'
        cpus=8
        memory='16G'
    }

    withLabel: r_ig_clustering {
        container='gmillot/r_v4.1.2_ig_clustering_v1.3:gitlab_v9.9'
        cpus=1
        memory='3G'
    }
}

//////// end directives


